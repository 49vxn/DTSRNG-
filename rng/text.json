    {
      "id": "help",
      "label": "How to play",
      "entries": [
        {
          "key": "help.intro",
          "label": "Opening help line",
          "context": "How to play",
          "value": "You walk the valley road. Your creatures trade syllables in alternating turns.",
          "placeholders": []
        },
        {
          "key": "help.types",
          "label": "Type triangle",
          "context": "How to play",
          "value": "Shout shatters song, song soothes hush, hush smothers shout.",
          "placeholders": []
        },
        {
          "key": "help.phrases",
          "label": "Phrase rule",
          "context": "How to play",
          "value": "Each creature carries two words and one phrase. A phrase hits once per fight with heavier force.",
          "placeholders": []
        },
        {
          "key": "help.commands",
          "label": "Command list",
          "context": "How to play",
          "value": "Commands: look, go north, go south, party, help, fight, quit, restart",
          "placeholders": []
        },
        {
          "key": "help.restart",
          "label": "Restart rule",
          "context": "How to play",
          "value": "restart works at any prompt and returns you to the road head.",
          "placeholders": []
        }
      ]
    },
    {
      "id": "areas",
      "label": "Areas and puzzles",
      "entries": [
        {
          "key": "area.signpost.name",
          "label": "Signpost Field name",
          "context": "The Signpost Field",
          "value": "The Signpost Field",
          "placeholders": []
        },
        {
          "key": "area.signpost.text",
          "label": "Signpost Field arrival",
          "context": "The Signpost Field",
          "value": "Gravel and wet ryegrass under stripped pine. Every board has been planed clean of ink. The track climbs north toward the ridge. Type look, then go north.",
          "placeholders": []
        },
        {
          "key": "area.signpost.look",
          "label": "Signpost Field look",
          "context": "The Signpost Field",
          "value": "Bleached timber posts with the grain standing proud. A sheep hurdle blocks the north road.",
          "placeholders": []
        },
        {
          "key": "area.mile.name",
          "label": "Crooked Mile name",
          "context": "The Crooked Mile",
          "value": "The Crooked Mile",
          "placeholders": []
        },
        {
          "key": "area.mile.text",
          "label": "Crooked Mile arrival",
          "context": "The Crooked Mile",
          "value": "The clay road turns three times to make a mile. Someone leans against a culvert with a creature on a rope.",
          "placeholders": []
        },
        {
          "key": "area.mile.look",
          "label": "Crooked Mile look",
          "context": "The Crooked Mile",
          "value": "Wagon ruts baked hard into mud. Your rival's creature watches your boots, not the road.",
          "placeholders": []
        },
        {
          "key": "puzzle.mile.prompt",
          "label": "Mile gate prompt",
          "context": "The Crooked Mile > gate",
          "value": "Boards nailed across the hurdle. Put the speech in order: opens / the / gate / if / ask / you / nicely",
          "placeholders": []
        },
        {
          "key": "puzzle.mile.hint",
          "label": "Mile gate hint",
          "context": "The Crooked Mile > gate",
          "value": "Lead with the subject.",
          "placeholders": []
        },
        {
          "key": "area.archive.name",
          "label": "Drowned Archive name",
          "context": "The Drowned Archive",
          "value": "The Drowned Archive",
          "placeholders": []
        },
        {
          "key": "area.archive.text",
          "label": "Drowned Archive arrival",
          "context": "The Drowned Archive",
          "value": "Cold floodwater over flagstones. White pine shelves dip straight into the cellar pool. A brass grate sits in the floor under carved Latin.",
          "placeholders": []
        },
        {
          "key": "area.archive.look",
          "label": "Drowned Archive look",
          "context": "The Drowned Archive",
          "value": "Sodden paper smells of silt and river moss. A thick-necked beast sleeps across the card cabinet.",
          "placeholders": []
        },
        {
          "key": "puzzle.archive.prompt",
          "label": "Archive drain prompt",
          "context": "The Drowned Archive > drain",
          "value": "The drain rim reads: Between you and ___, the archive is drowning. Name the object.",
          "placeholders": []
        },
        {
          "key": "puzzle.archive.hint",
          "label": "Archive drain hint",
          "context": "The Drowned Archive > drain",
          "value": "Not the speaker as subject.",
          "placeholders": []
        },
        {
          "key": "area.market.name",
          "label": "Market name",
          "context": "The Market of Small Lies",
          "value": "The Market of Small Lies",
          "placeholders": []
        },
        {
          "key": "area.market.text",
          "label": "Market arrival",
          "context": "The Market of Small Lies",
          "value": "Canvas stalls where syllables are traded on brass scales. A creature with three split tongues sits atop a padlocked crate.",
          "placeholders": []
        },
        {
          "key": "area.market.look",
          "label": "Market look",
          "context": "The Market of Small Lies",
          "value": "Hand-inked placards missing every vowel on purpose. The creature on the crate is already shaping your name.",
          "placeholders": []
        },
        {
          "key": "puzzle.market.prompt",
          "label": "Market vowel prompt",
          "context": "The Market of Small Lies > gate",
          "value": "The vendor slips you a card without vowels: S _ L _ N C E. Name what was bought.",
          "placeholders": []
        },
        {
          "key": "puzzle.market.hint",
          "label": "Market vowel hint",
          "context": "The Market of Small Lies > gate",
          "value": "What settles in the valley after dark.",
          "placeholders": []
        },
        {
          "key": "area.quiet.name",
          "label": "Quiet House name",
          "context": "The Quiet House",
          "value": "The Quiet House",
          "placeholders": []
        },
        {
          "key": "area.quiet.text",
          "label": "Quiet House arrival",
          "context": "The Quiet House",
          "value": "A stone gable where the valley wind stops dead. The timber door stands four inches open.",
          "placeholders": []
        },
        {
          "key": "area.quiet.look",
          "label": "Quiet House look",
          "context": "The Quiet House",
          "value": "Dark slate sills and iron hinges. A single word is written across the jamb in grease chalk.",
          "placeholders": []
        },
        {
          "key": "area.hollow.name",
          "label": "Quiet House inside name",
          "context": "The Quiet House, inside",
          "value": "The Quiet House, inside",
          "placeholders": []
        },
        {
          "key": "area.hollow.text",
          "label": "Quiet House inside arrival",
          "context": "The Quiet House, inside",
          "value": "Scrubbed kauri boards, dry lime mortar, and no echo. In the scullery, something sits on an iron kettle with its jaws unhinged.",
          "placeholders": []
        },
        {
          "key": "area.hollow.look",
          "label": "Quiet House inside look",
          "context": "The Quiet House, inside",
          "value": "It draws no breath through its teeth. It sits waiting for a syllable to catch.",
          "placeholders": []
        },
        {
          "key": "puzzle.open",
          "label": "Correct puzzle answer",
          "context": "Puzzle gates",
          "value": "The way opens.",
          "placeholders": []
        },
        {
          "key": "puzzle.wrong",
          "label": "Wrong puzzle answer",
          "context": "Puzzle gates",
          "value": "Nothing gives.",
          "placeholders": []
        }
      ]
