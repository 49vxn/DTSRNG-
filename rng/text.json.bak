    {
      "id": "combat",
      "label": "Combat",
      "entries": [
        {
          "key": "combat.status",
          "label": "Turn status line",
          "context": "Combat > every turn",
          "value": "{name} ({type}) {hp}/{max}   vs   {foe} ({foe_type}) {foe_hp}/{foe_max}",
          "placeholders": [
            "name",
            "type",
            "hp",
            "max",
            "foe",
            "foe_type",
            "foe_hp",
            "foe_max"
          ]
        },
        {
          "key": "combat.intent",
          "label": "Enemy intent",
          "context": "Combat > every turn",
          "value": "{foe} is winding up to say {word} ({type}).",
          "placeholders": [
            "foe",
            "word",
            "type"
          ]
        },
        {
          "key": "combat.menu",
          "label": "Combat menu",
          "context": "Combat > menu",
          "value": "1. speak   2. phrase ({phrase_state})   3. switch   4. run   5. quit",
          "placeholders": [
            "phrase_state"
          ]
        },
        {
          "key": "combat.phrase_spent_label",
          "label": "Phrase spent label",
          "context": "Combat > menu",
          "value": "spent",
          "placeholders": []
        },
        {
          "key": "combat.phrase_ready",
          "label": "Phrase ready",
          "context": "Combat > menu",
          "value": "ready",
          "placeholders": []
        },
        {
          "key": "combat.first_hint",
          "label": "First fight explainer",
          "context": "Combat > first fight",
          "value": "speak uses a word, phrase is one big strike per fight, switch swaps creature, run leaves.",
          "placeholders": []
        },
        {
          "key": "combat.which_word",
          "label": "Word prompt",
          "context": "Combat > speak",
          "value": "Which word?",
          "placeholders": []
        },
        {
          "key": "combat.not_a_word",
          "label": "Invalid word",
          "context": "Combat > speak",
          "value": "That is not a word. Pick a number from the list.",
          "placeholders": []
        },
        {
          "key": "combat.invalid",
          "label": "Invalid combat choice",
          "context": "Combat > menu",
          "value": "1, 2, 3, 4 or 5.",
          "placeholders": []
        },
        {
          "key": "combat.strong",
          "label": "Strong hit",
          "context": "Combat > damage",
          "value": "The word hits deep - {move_type} beats {target_type}.",
          "placeholders": [
            "move_type",
            "target_type"
          ]
        },
        {
          "key": "combat.weak",
          "label": "Weak hit",
          "context": "Combat > damage",
          "value": "The word glances off - {target_type} beats {move_type}.",
          "placeholders": [
            "move_type",
            "target_type"
          ]
        },
        {
          "key": "combat.hit",
          "label": "Damage line",
          "context": "Combat > damage",
          "value": "{attacker} uses {move} for {damage}.",
          "placeholders": [
            "attacker",
            "move",
            "damage"
          ]
        },
        {
          "key": "combat.faint",
          "label": "Creature faints",
          "context": "Combat > damage",
          "value": "{name} goes quiet.",
          "placeholders": [
            "name"
          ]
        },
        {
          "key": "combat.phrase_spent",
          "label": "Phrase already used",
          "context": "Combat > phrase",
          "value": "The phrase is spent.",
          "placeholders": []
        },
        {
          "key": "combat.phrase_speak",
          "label": "Phrase announcement",
          "context": "Combat > phrase",
          "value": "{name} speaks its phrase.",
          "placeholders": [
            "name"
          ]
        },
        {
          "key": "combat.recruit",
          "label": "Recruit message",
          "context": "Combat > win",
          "value": "{name} joins you.",
          "placeholders": [
            "name"
          ]
        },
        {
          "key": "combat.send_out",
          "label": "Switch prompt",
          "context": "Combat > switch",
          "value": "Send out who?",
          "placeholders": []
        },
        {
          "key": "combat.pick_number",
          "label": "Invalid switch",
          "context": "Combat > switch",
          "value": "Pick a number from the list.",
          "placeholders": []
        },
        {
          "key": "combat.no_words",
          "label": "Party wiped",
          "context": "Combat > loss",
          "value": "Your throat is empty.",
          "placeholders": []
        },
        {
          "key": "combat.run_away",
          "label": "Run away",
          "context": "Combat > run",
          "value": "You get out of the grass.",
          "placeholders": []
        },
        {
          "key": "combat.boss_rule",
          "label": "Boss shrugs off a clever word",
          "context": "The Quiet > any turn",
          "value": "{foe} swallows the word whole. It only flinches at {word}.",
          "placeholders": [
            "foe",
            "word"
          ]
        }
      ]
    },
    {
      "id": "house",
      "label": "The Quiet House",
      "entries": [
        {
          "key": "house.chalk",
          "label": "Chalk line",
          "context": "The Quiet House > first visit",
          "value": "The chalk on the door comes away on your hand. The word is {word}.",
          "placeholders": [
            "word"
          ]
        },
        {
          "key": "house.chalk_pass",
          "label": "Chalk passed round",
          "context": "The Quiet House > first visit",
          "value": "You pass it down the line, one clean word each.",
          "placeholders": []
        },
        {
          "key": "house.rest",
          "label": "Rest line",
          "context": "The Quiet House > damaged party",
          "value": "The house is quiet enough to hear yourself think. Your words come back.",
          "placeholders": []
        }
      ]
    },
    {
      "id": "ending",
      "label": "Ending",
      "entries": [
        {
          "key": "ending.part1",
          "label": "Boss falls",
          "context": "Ending",
          "value": "{foe} opens its mouth one last time, and nothing comes out.",
          "placeholders": [
            "foe"
          ]
        },
        {
          "key": "ending.part2",
          "label": "House settles",
          "context": "Ending",
          "value": "The house takes a breath. The floorboards creak. Upstairs, a door clicks shut.",
          "placeholders": []
        },
        {
          "key": "ending.walk",
          "label": "Walking out",
          "context": "Ending",
          "value": "{name} walks back out through the market with a word on their tongue.",
          "placeholders": [
            "name"
          ]
        },
        {
          "key": "ending.world1",
          "label": "The market and the signs",
          "context": "Ending",
          "value": "The stalls still sell letters by the weight. The signposts still point the wrong way.",
          "placeholders": []
        },
        {
          "key": "ending.world2",
          "label": "The road",
          "context": "Ending",
          "value": "The road still bends left and then left again. But the words are out, and the house is only a house.",
          "placeholders": []
        },
        {
          "key": "ending.thesis",
          "label": "Last line before the title",
          "context": "Ending",
          "value": "A story stays quiet only while nobody tells it.",
          "placeholders": []
        },
        {
          "key": "ending.the_end",
          "label": "Closing title",
          "context": "Ending",
          "value": "THE END",
          "placeholders": []
        }
      ]
    },
    {
      "id": "party",
      "label": "Party",
      "entries": [
        {
          "key": "party.title",
          "label": "Party heading",
          "context": "Party screen",
          "value": "{name}'s words:",
          "placeholders": [
            "name"
          ]
        },
        {
          "key": "party.line",
          "label": "Party creature line",
          "context": "Party screen",
          "value": "  {name} ({type}) {hp}/{max}",
          "placeholders": [
            "name",
            "type",
            "hp",
            "max"
          ]
        },
        {
          "key": "party.phrase",
          "label": "Party phrase line",
          "context": "Party screen",
          "value": "    phrase: {phrase}",
          "placeholders": [
            "phrase"
          ]
        }
      ]
    },
    {
      "id": "save",
      "label": "Save and load",
      "entries": [
        {
          "key": "save.none",
          "label": "No save found",
          "context": "Continue",
          "value": "There is no page to turn back to.",
          "placeholders": []
        },
        {
          "key": "save.continue",
          "label": "Continue message",
          "context": "Continue",
          "value": "{name} picks up where they left off.",
          "placeholders": [
            "name"
          ]
        }
      ]
    },
    {
      "id": "system",
      "label": "System",
      "entries": [
        {
          "key": "system.prompt",
          "label": "Input prompt",
          "context": "Everywhere",
          "value": "> ",
          "placeholders": []
        },
        {
          "key": "system.commands",
          "label": "Room command line",
          "context": "Every area",
