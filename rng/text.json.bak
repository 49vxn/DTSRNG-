{
  "version": 2,
  "groups": [
    {
      "id": "title",
      "label": "Title and menu",
      "entries": [
        {
          "key": "title.name",
          "label": "Game title",
          "context": "Title screen",
          "value": "RNG",
          "placeholders": []
        },
        {
          "key": "title.subtitle",
          "label": "Subtitle",
          "context": "Title screen",
          "value": "roll of the dice",
          "placeholders": []
        },
        {
          "key": "menu.new_game",
          "label": "New game option",
          "context": "Title menu",
          "value": "new game",
          "placeholders": []
        },
        {
          "key": "menu.continue",
          "label": "Continue option",
          "context": "Title menu",
          "value": "continue",
          "placeholders": []
        },
        {
          "key": "menu.how_to_play",
          "label": "How to play option",
          "context": "Title menu",
          "value": "how to play",
          "placeholders": []
        },
        {
          "key": "menu.quit",
          "label": "Quit option",
          "context": "Title menu",
          "value": "quit",
          "placeholders": []
        },
        {
          "key": "menu.hint",
          "label": "Restart hint",
          "context": "Title menu",
          "value": "type restart at any time to start again",
          "placeholders": []
        },
        {
          "key": "menu.invalid",
          "label": "Invalid menu choice",
          "context": "Title menu",
          "value": "Pick 1, 2, 3 or 4.",
          "placeholders": []
        }
      ]
    },
    {
      "id": "start",
      "label": "New game",
      "entries": [
        {
          "key": "start.name_prompt",
          "label": "Name prompt",
          "context": "New game",
          "value": "Your name: ",
          "placeholders": []
        },
        {
          "key": "start.pick_two",
          "label": "Starter choice",
          "context": "New game",
          "value": "Three creatures are waiting on the table. Each one fights with the words it knows. Pick two.",
          "placeholders": []
        },
        {
          "key": "start.starters",
          "label": "Starter list",
          "context": "New game",
          "value": "1. {claxon} ({claxon_type})   2. {mutter} ({mutter_type})   3. {lilt} ({lilt_type})",
          "placeholders": [
            "claxon",
            "claxon_type",
            "mutter",
            "mutter_type",
            "lilt",
            "lilt_type"
          ]
        },
        {
          "key": "start.and_one",
          "label": "Second starter prompt",
          "context": "New game",
          "value": "And one more to stand beside it.",
          "placeholders": []
        },
        {
          "key": "start.chosen",
          "label": "Starter confirmation",
          "context": "New game",
          "value": "{name} takes the {first} and the {second}. Type help at any prompt for the rules.",
          "placeholders": [
            "name",
            "first",
            "second"
          ]
        }
      ]
    },
    {
      "id": "help",
      "label": "How to play",
      "entries": [
        {
          "key": "help.intro",
          "label": "Opening help line",
          "context": "How to play",
          "value": "You are a roller. Your creatures fight with words, in turns, and you choose one word a turn.",
          "placeholders": []
        },
        {
          "key": "help.types",
          "label": "Type triangle",
          "context": "How to play",
          "value": "Shout beats song, song beats hush, hush beats shout.",
          "placeholders": []
        },
        {
          "key": "help.phrases",
          "label": "Phrase rule",
          "context": "How to play",
          "value": "Every creature has two words and one phrase. A phrase works once per fight and hits harder than a word.",
          "placeholders": []
        },
        {
          "key": "help.commands",
          "label": "Command list",
          "context": "How to play",
          "value": "Commands: look, go north, go south, party, help, fight, quit, restart",
          "placeholders": []
        },
        {
          "key": "help.restart",
          "label": "Restart rule",
          "context": "How to play",
          "value": "restart works at any prompt and puts you back at the title.",
          "placeholders": []
        }
      ]
    },
    {
      "id": "areas",
      "label": "Areas and puzzles",
      "entries": [
        {
          "key": "area.signpost.name",
          "label": "Signpost Field name",
          "context": "The Signpost Field",
          "value": "The Signpost Field",
          "placeholders": []
        },
        {
          "key": "area.signpost.text",
          "label": "Signpost Field arrival",
          "context": "The Signpost Field",
          "value": "A field of blank signposts. The grass is wet. One road goes north, toward the Quiet House. Type look, then go north when you are ready.",
          "placeholders": []
        },
        {
          "key": "area.signpost.look",
          "label": "Signpost Field look",
          "context": "The Signpost Field",
          "value": "The signposts have no names on them. The north road is shut by a gate.",
          "placeholders": []
        },
        {
          "key": "area.mile.name",
          "label": "Crooked Mile name",
          "context": "The Crooked Mile",
          "value": "The Crooked Mile",
          "placeholders": []
        },
        {
          "key": "area.mile.text",
          "label": "Crooked Mile arrival",
          "context": "The Crooked Mile",
          "value": "The road bends left and then left again. Someone is waiting on the verge with a creature you almost recognise.",
          "placeholders": []
        },
        {
          "key": "area.mile.look",
          "label": "Crooked Mile look",
          "context": "The Crooked Mile",
          "value": "The mile goes on. The rival's creature is watching you, not the road.",
          "placeholders": []
        },
        {
          "key": "puzzle.mile.prompt",
          "label": "Mile gate prompt",
          "context": "The Crooked Mile > gate",
          "value": "A sentence is nailed across the gate. Put it in order and type it: opens / the / gate / if / ask / you / nicely",
          "placeholders": []
        },
        {
          "key": "puzzle.mile.hint",
          "label": "Mile gate hint",
          "context": "The Crooked Mile > gate",
          "value": "Start with the gate.",
          "placeholders": []
        },
        {
          "key": "area.archive.name",
          "label": "Drowned Archive name",
          "context": "The Drowned Archive",
          "value": "The Drowned Archive",
          "placeholders": []
        },
        {
          "key": "area.archive.text",
          "label": "Drowned Archive arrival",
          "context": "The Drowned Archive",
          "value": "A library under a foot of water. The shelves go down further than the room. A drain is set in the floor, and a sentence is carved around it.",
          "placeholders": []
        },
        {
          "key": "area.archive.look",
          "label": "Drowned Archive look",
          "context": "The Drowned Archive",
          "value": "The water is warm. Something with a foghorn throat is asleep on the desk.",
          "placeholders": []
        },
        {
          "key": "puzzle.archive.prompt",
          "label": "Archive drain prompt",
          "context": "The Drowned Archive > drain",
          "value": "The drain says: Between you and ___, the archive is drowning. Type the missing word.",
          "placeholders": []
        },
        {
          "key": "puzzle.archive.hint",
          "label": "Archive drain hint",
          "context": "The Drowned Archive > drain",
          "value": "It is not I.",
          "placeholders": []
        },
        {
          "key": "area.market.name",
          "label": "Market name",
          "context": "The Market of Small Lies",
          "value": "The Market of Small Lies",
          "placeholders": []
        },
        {
          "key": "area.market.text",
          "label": "Market arrival",
          "context": "The Market of Small Lies",
          "value": "A row of stalls selling words by the letter. A small many-tongued thing is sitting on the counter of the closed stall.",
          "placeholders": []
        },
        {
          "key": "area.market.look",
          "label": "Market look",
          "context": "The Market of Small Lies",
          "value": "The signs are spelled wrong on purpose. The thing on the counter is already telling someone about you.",
          "placeholders": []
        },
        {
          "key": "puzzle.market.prompt",
          "label": "Market vowel prompt",
          "context": "The Market of Small Lies > gate",
          "value": "A vendor sells you a word with the vowels missing: S _ L _ N C E. What did you buy? Type the word.",
          "placeholders": []
        },
        {
          "key": "puzzle.market.hint",
          "label": "Market vowel hint",
          "context": "The Market of Small Lies > gate",
          "value": "It is what the quiet house is full of.",
          "placeholders": []
        },
        {
          "key": "area.quiet.name",
          "label": "Quiet House name",
          "context": "The Quiet House",
          "value": "The Quiet House",
          "placeholders": []
        },
        {
          "key": "area.quiet.text",
          "label": "Quiet House arrival",
          "context": "The Quiet House",
          "value": "A house with no sound coming out of it. The door is open.",
          "placeholders": []
        },
        {
          "key": "area.quiet.look",
          "label": "Quiet House look",
          "context": "The Quiet House",
          "value": "The windows are dark. Someone has written on the door in chalk.",
          "placeholders": []
        },
        {
          "key": "area.hollow.name",
          "label": "Quiet House inside name",
          "context": "The Quiet House, inside",
          "value": "The Quiet House, inside",
          "placeholders": []
        },
        {
          "key": "area.hollow.text",
          "label": "Quiet House inside arrival",
          "context": "The Quiet House, inside",
          "value": "Every room has been emptied of sound. Carpets, books, a cold hearth, and no echo at all. Something is sitting in the last room with its mouth open.",
          "placeholders": []
        },
        {
          "key": "area.hollow.look",
          "label": "Quiet House inside look",
          "context": "The Quiet House, inside",
          "value": "The thing in the last room is not breathing. It is listening.",
          "placeholders": []
        },
        {
          "key": "puzzle.open",
          "label": "Correct puzzle answer",
          "context": "Puzzle gates",
          "value": "The gate opens.",
          "placeholders": []
        },
        {
          "key": "puzzle.wrong",
          "label": "Wrong puzzle answer",
          "context": "Puzzle gates",
          "value": "The gate does not move.",
          "placeholders": []
        }
      ]
    },
