    {
      "id": "ending",
      "label": "Ending",
      "entries": [
        {
          "key": "ending.part1",
          "label": "Boss falls",
          "context": "Ending",
          "value": "{foe} shuts its jaw with the crack of dry heartwood. Nothing answers.",
          "placeholders": [
            "foe"
          ]
        },
        {
          "key": "ending.part2",
          "label": "House settles",
          "context": "Ending",
          "value": "The flue exhales. Floorboards settle. Upstairs, a sash weight knocks once and goes still.",
          "placeholders": []
        },
        {
          "key": "ending.walk",
          "label": "Walking out",
          "context": "Ending",
          "value": "{name} walks back into the scrub with an unspent word under the tongue.",
          "placeholders": [
            "name"
          ]
        },
        {
          "key": "ending.world1",
          "label": "The market and the signs",
          "context": "Ending",
          "value": "The stalls still peddle consonants by the pound. The posts still stand blank above the gravel.",
          "placeholders": []
        },
        {
          "key": "ending.world2",
          "label": "The road",
          "context": "Ending",
          "value": "The clay road still doubles back on itself. But the house is only cold timber and slate.",
          "placeholders": []
        },
        {
          "key": "ending.thesis",
          "label": "Last line before the title",
          "context": "Ending",
          "value": "A valley stays hollow only while no one will pronounce it.",
          "placeholders": []
        },
        {
          "key": "ending.the_end",
          "label": "Closing title",
          "context": "Ending",
          "value": "THE END",
          "placeholders": []
        }
